<% content_for :title, "Group review" %>
<% turbo_exempts_page_from_cache %>
<%= link_to "Back to the queue", reviews_path, class: "link" %>
<h1 class="page-title mt-4">One decision for identical cards</h1>
<p class="page-lead">The title, description, seller data, category and original hint all match. Only the values listed below will change. At most 100 at a time.</p>
<section class="panel panel-pad mt-6">
  <h2 class="font-semibold"><%= seed.title %>: <%= seed.value %></h2>
  <p class="mt-2 text-sm text-muted">Source: <%= source_label(seed.source) %>. <%= review_doubt(seed) %></p>
  <h3 class="mt-4 font-semibold">Shared card text</h3>
  <p class="mt-2 break-words"><%= seed.card.title %></p>
  <p class="mt-2 whitespace-pre-wrap break-words"><%= seed.card.description.presence || "No description" %></p>
  <% if seed.card.seller_attributes.present? %>
    <dl class="mt-3"><% seed.card.seller_attributes.each do |key, value| %>
      <dt class="font-semibold"><%= key %></dt><dd class="break-words"><%= value %></dd>
    <% end %></dl>
  <% end %>
</section>
<section class="panel panel-pad mt-4">
  <h2 class="font-semibold">Values to change: <%= values.size %></h2>
  <ul class="mt-3 grid gap-2"><% values.each do |value| %>
    <li><%= link_to "Card ##{value.card_id}", card_path(value.card), class: "link", target: "_blank", rel: "noopener" %>
      · ID: <%= value.card.external_id.presence || value.card_id %> · <%= value.title %>: <%= value.value %></li>
  <% end %></ul>
  <% if values.size >= 2 %>
    <%= form_with url: review_groups_path, data: { turbo: false }, class: "mt-5 grid gap-3" do %>
      <%= hidden_field_tag :token, token %>
      <p class="text-sm text-muted">Check the shared text and the list of cards. After saving, the decision can be undone for 15 minutes, as long as the values have not changed again.</p>
      <%= button_tag "Confirm all #{values.size}", name: :decision, value: "approve", class: "btn btn-success" %>
      <%= label_tag :value, "Or enter the correct value for the whole group", class: "font-semibold" %>
      <%= text_field_tag :value, nil, class: "input", autocomplete: "off" %>
      <%= button_tag "Correct all #{values.size}", name: :decision, value: "correct", class: "btn btn-secondary" %>
    <% end %>
  <% else %>
    <p class="mt-4">No matching duplicates. Review the value in the regular queue.</p>
  <% end %>
</section>
