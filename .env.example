# Copy to .env. Without LLM_API_KEY everything runs on rules and dictionaries alone.
LLM_API_KEY=
# Standard OpenAI variables are accepted too. The case VM already exports OPENAI_API_KEY and OPENAI_BASE_URL.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
# openai (any OpenAI-compatible endpoint) or anthropic.
LLM_PROVIDER=openai
# Leave empty for the provider's own endpoint.
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
# 0 when the endpoint refuses a JSON schema in response_format.
LLM_STRUCTURED=1
# The most requests one run may make, and how long one may take (seconds).
LLM_MAX_CALLS=2000
LLM_TIMEOUT=30
# off = recommended production mode: the measured gain from LLM is only 0.002 F1.
# Turn it on only for an experiment that proves a useful gain on held-out case data.
LLM_MODE=off
# strict (default): threshold >=0.98 for every field; manual gates in config/acceptance.yml.
# standard: historical catalogue thresholds, for comparison with old benchmarks.
ACCEPTANCE_MODE=strict
# Cards read at once; raise it when the model is the slow part.
EXTRACT_THREADS=6
# The learned layer between rules and the model: perceptron (config/tagger/perceptron.json.gz, from bin/learn),
# transformer (config/tagger/transformer, from script/ner/train.py) or off.
TAGGER=perceptron
# CPU threads the transformer may use per card (cards are already read several at a time).
TAGGER_THREADS=1
